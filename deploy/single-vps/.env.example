# Copy this file to deploy/single-vps/.env before running docker compose.

POSTGRES_DB=mhv
POSTGRES_USER=mhv
POSTGRES_PASSWORD=change_me_now

JWT_SECRET=change_me_to_a_long_random_secret
APP_SEED_DEMO_USERS_ENABLED=false

# When frontend and backend share one domain via nginx, keep this empty.
VITE_API_BASE_URL=

# Replace with your real domain after pointing DNS to the VPS.
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com
